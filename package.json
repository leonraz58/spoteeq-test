{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "eslint-check": "eslint --ext .js,.ts,.vue.",
    "eslint-fix": "eslint --ext .js,.ts,.vue . --fix",
    "prettier-check": "prettier . \"!**/*.{js,ts,vue,css,scss}\" --check",
    "prettier-fix": "prettier . \"!**/*.{js,ts,vue,css,scss}\" --write",
    "stylelint-check": "stylelint \"**/*.{css,scss,vue}\"",
    "stylelint-fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "lint": "yarn eslint-check && yarn stylelint-check && yarn prettier-check",
    "lint:fix": "prettier --write --list-different . && yarn eslint-check --fix && yarn stylelint-check --fix"
  },
  "dependencies": {
    "@nuxt/eslint": "1.4.1",
    "eslint": "^9.0.0",
    "nuxt": "4.1.2",
    "nuxt-svgo": "4.2.3",
    "sass": "^1.89.2",
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.21.0",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.2",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
